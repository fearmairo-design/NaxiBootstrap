<Window x:Class="NaxiBootstrap.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Naxi Bootstrap" Width="1200" Height="760" MinWidth="1024" MinHeight="660"
        WindowStyle="None" ResizeMode="CanResize" AllowsTransparency="True" Background="Transparent" WindowStartupLocation="CenterScreen">
    <Border Background="{StaticResource Bg}" CornerRadius="14" BorderBrush="#1C2028" BorderThickness="1" ClipToBounds="True">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <Image x:Name="BgImage" Grid.Row="0" Grid.RowSpan="2" Stretch="UniformToFill" Visibility="Collapsed"/>
            <Rectangle x:Name="BgOverlay" Grid.Row="0" Grid.RowSpan="2" Fill="#E60B0D12" Visibility="Collapsed"/>

            <Grid Grid.RowSpan="2" IsHitTestVisible="False">
                <Ellipse Width="640" Height="640" Margin="-220,-280,0,0">
                    <Ellipse.Fill>
                        <RadialGradientBrush>
                            <GradientStop Color="#147CB7E0" Offset="0"/>
                            <GradientStop Color="#007CB7E0" Offset="1"/>
                        </RadialGradientBrush>
                    </Ellipse.Fill>
                </Ellipse>
                <Ellipse Width="700" Height="700" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,-260,-320">
                    <Ellipse.Fill>
                        <RadialGradientBrush>
                            <GradientStop Color="#0E5E9CC8" Offset="0"/>
                            <GradientStop Color="#005E9CC8" Offset="1"/>
                        </RadialGradientBrush>
                    </Ellipse.Fill>
                </Ellipse>
            </Grid>

            <Grid Grid.Row="0" Margin="28,18,18,0" MouseLeftButtonDown="DragWindow">
                <StackPanel Orientation="Horizontal">
                    <Border Width="28" Height="28" CornerRadius="9" VerticalAlignment="Center" Margin="0,0,16,0" BorderBrush="#4A7A96" BorderThickness="1">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="#8FC4EA" Offset="0"/>
                                <GradientStop Color="#5E9CC8" Offset="1"/>
                            </LinearGradientBrush>
                        </Border.Background>
                        <TextBlock Text="N" FontSize="14" FontWeight="Bold" Foreground="#0A1420" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <Border Background="#12151B" BorderBrush="#20252E" BorderThickness="1" CornerRadius="20" Padding="5" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <Button x:Name="HomeNav" Content="Home" Style="{StaticResource NavButtonActive}" Click="Home_Click"/>
                            <Button x:Name="AccountsNav" Content="Accounts" Style="{StaticResource NavButton}" Click="Accounts_Click"/>
                            <Button x:Name="FlagsNav" Content="FastFlags" Style="{StaticResource NavButton}" Click="Flags_Click"/>
                            <Button x:Name="MaintenanceNav" Content="Maintenance" Style="{StaticResource NavButton}" Click="Maintenance_Click"/>
                            <Button x:Name="SettingsNav" Content="Settings" Style="{StaticResource NavButton}" Click="Settings_Click"/>
                            <Button x:Name="AboutNav" Content="About us" Style="{StaticResource NavButton}" Click="About_Click"/>
                            <Button x:Name="LegalNav" Content="Legal" Style="{StaticResource NavButton}" Click="Legal_Click"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top">
                    <Button Content="—" Style="{StaticResource WindowButton}" Click="Minimize_Click"/>
                    <Button Content="✕" Style="{StaticResource WindowButton}" Click="Close_Click"/>
                </StackPanel>
            </Grid>

            <ContentControl x:Name="PageHost" Grid.Row="1" Margin="0,16,0,34" ClipToBounds="True"/>
        </Grid>
    </Border>
</Window>
